{
    "name": "wp-formvault/wp-formvault",
    "description": "Centralized form-submission reporting, scheduling, workflow, export, and secure delivery for supported WordPress form plugins.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-xml": "*",
        "ext-xmlreader": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "maennchen/zipstream-php": "~3.0.2",
        "phpoffice/phpspreadsheet": "~5.8.1",
        "woocommerce/action-scheduler": "~3.9.3"
    },
    "require-dev": {
        "brianhenryie/strauss": "0.28.1",
        "php-stubs/wordpress-stubs": "6.5.7",
        "phpstan/phpstan": "~2.2.6",
        "phpunit/phpunit": "~9.6.35",
        "squizlabs/php_codesniffer": "~3.13.5",
        "wp-coding-standards/wpcs": "~3.4.1",
        "yoast/phpunit-polyfills": "~3.1.2"
    },
    "autoload": {
        "psr-4": {
            "WPFormVault\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPFormVault\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "platform-check": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "build-dependencies": [
            "@php tools/clean-generated-dependencies.php",
            "@prefix-dependencies",
            "@patch-prefixed-dependencies",
            "@stage-action-scheduler",
            "@generate-dependency-notices",
            "@lint-generated-dependencies",
            "@verify-dependencies"
        ],
        "generate-dependency-notices": "@php tools/generate-dependency-notices.php",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "lint": [
            "@lint:phpcs",
            "@lint:phpcompatibility"
        ],
        "lint:phpcompatibility": "tools/phpcompatibility/vendor/bin/phpcs --standard=phpcompatibility.xml.dist",
        "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
        "lint-generated-dependencies": "@php tools/lint-generated-dependencies.php",
        "patch-prefixed-dependencies": "@php tools/patch-prefixed-dependencies.php",
        "prefix-dependencies": "strauss",
        "qa": [
            "@qa:install-phpcompatibility",
            "@verify-quality-tooling",
            "@lint",
            "@analyse",
            "@test:unit"
        ],
        "qa:install-phpcompatibility": "composer install --working-dir=tools/phpcompatibility --no-interaction --no-progress --prefer-dist",
        "stage-action-scheduler": "@php tools/stage-action-scheduler.php",
        "test:unit": "phpunit --configuration=phpunit.xml.dist --testsuite=unit",
        "test:integration": "phpunit --configuration=phpunit.integration.xml.dist --testsuite=integration",
        "test:functional": "phpunit --configuration=phpunit.integration.xml.dist --testsuite=functional",
        "test:security": "phpunit --configuration=phpunit.integration.xml.dist --testsuite=security",
        "test:performance": "phpunit --configuration=phpunit.integration.xml.dist --testsuite=performance",
        "verify-dependencies": "@php tools/verify-dependencies.php",
        "verify-quality-tooling": "@php tools/verify-qa-tooling.php"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "WPFormVault\\Vendor\\",
            "classmap_prefix": "WPFormVault_Vendor_",
            "constant_prefix": "WPFV_VENDOR_",
            "packages": [
                "composer/pcre",
                "maennchen/zipstream-php",
                "markbaker/complex",
                "markbaker/matrix",
                "phpoffice/phpspreadsheet",
                "psr/simple-cache"
            ],
            "update_call_sites": false,
            "include_root_autoload": false,
            "classmap_output": true,
            "optimize_autoloader": true,
            "delete_vendor_packages": false,
            "delete_vendor_files": false,
            "exclude_git_files": true,
            "include_modified_date": false,
            "include_author": false
        }
    }
}
