<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/Support/Integration/bootstrap.php"
	cacheResult="true"
	cacheResultFile="build/phpunit/integration.cache"
	colors="true"
	failOnRisky="true"
	failOnWarning="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/Integration</directory>
		</testsuite>
		<testsuite name="functional">
			<directory suffix="Test.php">tests/Functional</directory>
		</testsuite>
		<testsuite name="security">
			<directory suffix="Test.php">tests/Security</directory>
		</testsuite>
		<testsuite name="performance">
			<directory suffix="Test.php">tests/Performance</directory>
		</testsuite>
		<testsuite name="required-minimum-mysql">
			<directory suffix="Test.php">tests/Integration</directory>
			<directory suffix="Test.php">tests/Security</directory>
		</testsuite>
		<testsuite name="required-current">
			<directory suffix="Test.php">tests/Integration</directory>
			<directory suffix="Test.php">tests/Functional</directory>
			<directory suffix="Test.php">tests/Security</directory>
		</testsuite>
		<testsuite name="required-multisite">
			<directory suffix="Test.php">tests/Integration</directory>
			<directory suffix="Test.php">tests/Functional</directory>
		</testsuite>
		<testsuite name="required-trunk">
			<directory suffix="Test.php">tests/Integration</directory>
			<directory suffix="Test.php">tests/Functional</directory>
		</testsuite>
	</testsuites>
</phpunit>
