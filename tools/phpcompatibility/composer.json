{
    "name": "wp-formvault/phpcompatibility-tool",
    "description": "Isolated PHPCompatibilityWP toolchain for WP FormVault.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
        "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
        "squizlabs/php_codesniffer": "4.0.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
